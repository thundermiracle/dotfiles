#!/usr/bin/env bash
# claude shim — herdr でペインを復元したときに effort とモデルも戻す
#
# herdr は Claude のペインを復元するとき、ペインのシェルに `claude --resume <id>` を打ち込む
# （herdr-app の agent-resume も同じ）。Claude Code は resume で effort をモデルの保存値に戻し、
# モデルは会話の回答から戻すので、まだ回答のないセッションは /model で選んでいても既定に戻る。
# そこで ~/.claude/effort-recorder.sh が記録したそのセッションの effort とモデルを、
# --effort / --model として付け足す。
#
# 付け足すのは次をすべて満たすときだけ。それ以外の起動は引数を変えずに本物へ渡す。
#   - 引数に --resume <uuid> / -r <uuid> / --resume=<uuid> がある
#   - --effort（モデルは --model）が指定されていない
#   - CLAUDE_CODE_EFFORT_LEVEL（モデルは ANTHROPIC_MODEL）が設定されていない（引数とどちらが勝つか未確認のため）
#   - ~/.cache/claude-effort/<uuid>（モデルは ~/.cache/claude-model/<uuid>）に有効な値が記録されている
#
# このディレクトリは PATH の先頭に置く（~/.zshrc の最後で追加。.zshenv だと path_helper に負ける）。

EFFORT_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-effort"
MODEL_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-model"
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
MODEL_RE='^[A-Za-z0-9][]A-Za-z0-9._:/@[-]*$'

# 本物の claude: PATH のうち、この shim 自身のディレクトリ以外で最初に見つかるもの。
# PATH になければ、インストール方法ごとの既定の場所を順に探す。
#   ~/.local/bin       公式インストーラ
#   /opt/homebrew/bin  Apple Silicon の Homebrew
#   /usr/local/bin     Intel の Homebrew
real_claude=
self_dir=$(cd "$(dirname "$0")" && pwd -P)
IFS=: read -r -a path_dirs <<<"$PATH"
for dir in "${path_dirs[@]}" "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
  [ -n "$dir" ] && [ -f "$dir/claude" ] && [ -x "$dir/claude" ] || continue
  [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$self_dir" ] && continue
  real_claude="$dir/claude"
  break
done

if [ -z "$real_claude" ]; then
  echo "claude shim: real claude not found in PATH, ~/.local/bin, /opt/homebrew/bin or /usr/local/bin" >&2
  exit 127
fi

sid=
has_effort=
has_model=
prev=
for arg in "$@"; do
  [ "$arg" = -- ] && break
  case "$prev" in
    --resume | -r) sid=$arg ;;
  esac
  case "$arg" in
    --effort | --effort=*) has_effort=1 ;;
    --model | --model=*) has_model=1 ;;
    --resume=*) sid=${arg#--resume=} ;;
  esac
  prev=$arg
done

extra=()
if [[ $sid =~ $UUID_RE ]]; then
  if [ -z "$has_effort" ] && [ -z "${CLAUDE_CODE_EFFORT_LEVEL:-}" ] && [ -r "$EFFORT_DIR/$sid" ]; then
    level=
    IFS= read -r level <"$EFFORT_DIR/$sid"
    case "$level" in
      low | medium | high | xhigh | max) extra+=(--effort "$level") ;;
    esac
  fi
  if [ -z "$has_model" ] && [ -z "${ANTHROPIC_MODEL:-}" ] && [ -r "$MODEL_DIR/$sid" ]; then
    model=
    IFS= read -r model <"$MODEL_DIR/$sid"
    [[ $model =~ $MODEL_RE ]] && extra+=(--model "$model")
  fi
fi

# 元の引数より前に置く（`--` 以降に付くとプロンプト扱いになるため）
exec "$real_claude" ${extra[@]+"${extra[@]}"} "$@"
