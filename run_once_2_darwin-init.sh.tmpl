{{ if eq .chezmoi.os "darwin" -}}
#!/bin/zsh

# install nodejs
fnm install 24
fnm default 24

# install rust
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

# apply settings
zsh $HOME/.zshrc

# apply pnpm
corepack enable pnpm

# install wasm-rust
cargo install wasm-pack

# install 1pass plugin aws
eval $(op signin)
op plugin init aws
op plugin init cdk

{{ end -}}
