#!/bin/bash
# ~/.claude/settings.json の statusLine と agent-resume のフックだけを chezmoi で管理する。
# ほかの項目は Claude Code 自身も書き換えるので触らない。
# chezmoi が今の中身を標準入力で渡し、標準出力の内容でファイルを置き換える。
#
# statusLine: effort-recorder.sh がセッションごとの effort を記録し、
# herdr がペインを復元するときに claude shim が --effort として付け足す。
#
# hooks の SessionStart / SessionEnd: agent-resume（~/.local/bin/agent-resume）が herdr-app の
# ターミナルにセッションを記録し、PC の再起動でタブが戻ったときに claude --resume で再開する。
# 同じコマンドのフックがあればその場で書き換え、なければ末尾にグループを足す（herdr のフックには触らない）。

status_line='{"type":"command","command":"~/.claude/effort-recorder.sh","refreshInterval":10}'

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp" "$tmp.out"' EXIT
cat >"$tmp"

if ! command -v jq >/dev/null 2>&1; then
  if [ -s "$tmp" ]; then
    echo "modify_settings.json: jq がないので ~/.claude/settings.json の statusLine とフックは設定しません" >&2
    cat "$tmp"
  else
    # まだファイルがない（新しい PC）ときは jq なしで作る。agent-resume も jq を使うので、フックは足さない
    cat <<'EOF'
{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/effort-recorder.sh",
    "refreshInterval": 10
  }
}
EOF
  fi
  exit 0
fi

[ -s "$tmp" ] || echo '{}' >"$tmp"
if jq --argjson s "$status_line" --arg bin "$HOME/.local/bin/agent-resume" '
  def upsert($h):
    (. // []) as $groups
    | if any($groups[]; any(.hooks[]?; .command? == $h.command))
      then $groups | map(if (.hooks | type) == "array"
                         then .hooks |= map(if .command? == $h.command then $h else . end)
                         else . end)
      else $groups + [{hooks: [$h]}]
      end;
  .statusLine = $s
  | .hooks.SessionStart |= upsert({type: "command", command: "\($bin) record claude", timeout: 5})
  | .hooks.SessionEnd |= upsert({type: "command", command: "\($bin) end claude", timeout: 3})
' "$tmp" >"$tmp.out"; then
  cat "$tmp.out"
else
  echo "modify_settings.json: ~/.claude/settings.json が JSON として読めないので変更しません" >&2
  cat "$tmp"
fi
