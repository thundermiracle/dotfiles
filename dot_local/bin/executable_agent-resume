#!/usr/bin/env bash
# agent-resume — herdr-app のタブで動いていた Claude Code / Codex を、PC の再起動のあとに再開する
#
# herdr-app のタブは herdr-core（hc）の keep 付きのターミナルで、再起動・ログアウト・core の停止のあと、
# 同じアドレス（$HC_TERMINAL_ID）と同じラベルのまま、新しいログインシェルで戻ってくる。
# 元のプログラムは起動し直さないので、エージェントが動いている間はターミナルに resume.* の
# ラベルを貼っておき、戻ってきたシェルがそれを読んで claude --resume / codex resume を打つ。
#
#   agent-resume record <claude|codex>  SessionStart のフック。ラベルを貼る
#   agent-resume end <claude|codex>     SessionEnd のフック。自分で終了したときだけラベルを消す
#   agent-resume init zsh               ~/.zshrc で eval する。戻ってきたシェルで再開する。
#                                       プロンプトで打った codex には --no-daemon を付ける
#
# ラベル（hc get <t> --json の labels）:
#   resume.agent / resume.id / resume.cwd  エージェント・セッション ID・フォルダ
#   resume.args        再開するときにも付ける引数（JSON の配列）
#   resume.transcript  セッションの記録ファイル。まだなければ（何も送っていない）再開せず、ラベルを消す
#   resume.pid / resume.boot  ラベルを持つシェル（ターミナルの最上位のシェル）の pid と起動 ID
#
# ラベルはターミナルごと（タブ、分割したペインごと）なので、同じスペースの複数のタブはそれぞれ戻る。
# 1 つのターミナルで追うエージェントは 1 つ。Ctrl-Z で止めて別のエージェントを起動すると、後のほうで上書きする。
# Codex の SessionStart は最初のターンで来るので、まだ何も送っていない Codex は記録しない
# （/new のあとも、最初のターンまでは前のセッションのまま）。
# モデルと effort は、Claude は statusLine（~/.claude/effort-recorder.sh）の記録から claude shim
# （~/.claude-shim/bin/claude）が、Codex は codex resume 自体が戻す。
# 何をしたか、しなかった理由は ~/.local/state/agent-resume.log に残す。
# フックとして呼ばれたときは、何があっても 0 で終わり、セッションを止めない。

UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/agent-resume.log

have_tools() {
  command -v jq >/dev/null 2>&1 && command -v hc >/dev/null 2>&1
}

# 起動ごとに変わる ID。pid は再起動をまたぐと同じ番号になりうるので、これと組にして比べる
# （macOS の kern.boottime は時刻合わせでずれるので使わない）
boot_id() {
  if [ -r /proc/sys/kernel/random/boot_id ]; then
    cat /proc/sys/kernel/random/boot_id
  else
    sysctl -n kern.bootsessionuuid 2>/dev/null
  fi
}

# JSON（$2）から jq の式（$1。値の配列を返す）で取り出した値を、配列 FIELDS に入れる。
# null は空文字にする。改行などを含む値でもずれないよう、NUL 区切りで受け渡す
read_fields() {
  local f
  FIELDS=()
  while IFS= read -r -d '' f; do
    FIELDS+=("$f")
  done < <(jq -j "($1)"' | map(. // "" | tostring | gsub("\u0000"; "")) | .[] | (., "\u0000")' <<<"$2" 2>/dev/null)
}

# 1 行残す。フックは黙って 0 で終わるので、記録漏れなどに後から気付けるように。
# 1 MB を超えたら .1 に回す（回せなければ書かない）。書けなくても止めない
log() {
  {
    mkdir -p "${LOG%/*}"
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 1048576 ]; then
      mv -f "$LOG" "$LOG.1" || return 0
    fi
    printf '%s %s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "${HC_TERMINAL_ID:-}" "$*" >>"$LOG"
  } 2>/dev/null
  return 0
}

# ラベルを消し、$1（どのセッションのラベルを、なぜ消すか）と結果を残す
clear_labels() {
  if hc label "$HC_TERMINAL_ID" resume.agent= resume.id= resume.cwd= resume.args= \
    resume.transcript= resume.pid= resume.boot= >/dev/null 2>&1; then
    log "$1, cleared"
  else
    log "$1, but hc label failed"
  fi
}

# このフックを動かしているエージェントの pid: 祖先のうち、いちばん近い claude / codex。
# それが $1（フックの種類）と違う名前なら何も出さない
agent_pid() {
  local p=$PPID comm
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    comm=$(ps -o comm= -p "$p" 2>/dev/null) || return 1
    case "${comm##*/}" in
      claude | codex)
        [ "${comm##*/}" = "$1" ] || return 1
        echo "$p"
        return 0
        ;;
    esac
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
  return 1
}

# pid $1 が、ターミナルの前面のジョブの先頭か。hc の見る前面と同じものを、遅れなしに ps で見る。
# $2: ターミナルの最上位のプロセス。同じ端末か比べる（中で動かした tmux の中などは別の端末）
foreground_job() {
  local pgid tpgid tty
  read -r pgid tpgid tty <<<"$(ps -o pgid=,tpgid=,tty= -p "$1" 2>/dev/null)"
  [ -n "$pgid" ] && [ "$pgid" = "$1" ] && [ "$tpgid" = "$1" ] &&
    [ "$tty" = "$(ps -o tty= -p "$2" 2>/dev/null | tr -d ' ')" ]
}

# エージェントの引数（$2 以降）のうち、再開するときにも付けるものだけを JSON の配列で出す。
# argv をそのまま写すと、shim が足した --effort や前回の --resume <id>、最初のプロンプトまで
# 付いてしまうので、決めたものだけを残す。--effort と --model は残さず、セッションのものに戻す
# （Claude は statusLine の記録から、Codex は codex resume 自体が）
keep_args() {
  local agent=$1 a i=1 n=$#
  local -a argv=("$@") keep=()
  while [ "$i" -lt "$n" ]; do
    a=${argv[$i]}
    [ "$a" = -- ] && break
    case "$agent:$a" in
      claude:--dangerously-skip-permissions | claude:--allow-dangerously-skip-permissions | \
        claude:--permission-mode=* | claude:--add-dir=* | \
        codex:--no-daemon | codex:--dangerously-bypass-approvals-and-sandbox | codex:--full-auto | \
        codex:--approve-for-me | codex:--search | \
        codex:--sandbox=* | codex:--ask-for-approval=* | codex:--add-dir=* | codex:--profile=*)
        keep+=("$a")
        ;;
      claude:--permission-mode | codex:-s | codex:--sandbox | codex:-a | codex:--ask-for-approval | \
        codex:--add-dir | codex:-p | codex:--profile)
        if [ $((i + 1)) -lt "$n" ]; then
          keep+=("$a" "${argv[$((i + 1))]}")
          i=$((i + 1))
        fi
        ;;
      claude:--add-dir)
        # 値をいくつでも取る（次の - で始まる引数まで）
        keep+=("$a")
        while [ $((i + 1)) -lt "$n" ] && [ "${argv[$((i + 1))]#-}" = "${argv[$((i + 1))]}" ]; do
          i=$((i + 1))
          keep+=("${argv[$i]}")
        done
        ;;
    esac
    i=$((i + 1))
  done
  if [ "${#keep[@]}" -eq 0 ]; then
    echo '[]'
  else
    printf '%s\0' "${keep[@]}" | jq -Rsc 'split("\u0000") | .[:-1]'
  fi
}

# エージェントの引数（$2 以降）が、一度きりで終わる起動（claude -p、codex exec など）か
one_shot() {
  local agent=$1 a skip=
  shift
  for a in "$@"; do
    [ "$a" = -- ] && return 1
    if [ "$agent" = claude ]; then
      case "$a" in
        --print | --no-session-persistence) return 0 ;;
        # -p と、-cp のようにまとめた短いオプション
        -[!-]*) case "$a" in *p*) return 0 ;; esac ;;
      esac
      continue
    fi
    # codex: 最初の位置引数がサブコマンド。値を取るオプションの値は飛ばす
    if [ -n "$skip" ]; then
      skip=
      continue
    fi
    case "$a" in
      -c | --config | --enable | --disable | --remote | --remote-auth-token-env | -i | --image | \
        -m | --model | --local-provider | -p | --profile | -s | --sandbox | -C | --cd | --add-dir | \
        -a | --ask-for-approval)
        skip=1
        ;;
      -*) ;;
      exec | e | review) return 0 ;;
      *) return 1 ;;
    esac
  done
  return 1
}

cmd_record() {
  local agent=$1 input sid sub cwd transcript term fg pid ap i=0
  input=$(cat)
  case "$agent" in claude | codex) ;; *) return 0 ;; esac
  [ -n "${HC_TERMINAL_ID:-}" ] && have_tools || return 0
  read_fields '[.session_id, .agent_id, .cwd, .transcript_path]' "$input"
  sid=${FIELDS[0]:-} sub=${FIELDS[1]:-} cwd=${FIELDS[2]:-} transcript=${FIELDS[3]:-}
  if ! [[ $sid =~ $UUID_RE ]]; then
    log "record $agent: no session id"
    return 0
  fi
  # Claude のサブエージェント
  [ -z "$sub" ] || return 0
  # Codex のツールから起動した codex は、親のスレッド ID を受け継いでいる
  if [ "$agent" = codex ] && [ -n "${CODEX_THREAD_ID:-}" ] && [ "$CODEX_THREAD_ID" != "$sid" ]; then
    log "record codex $sid: started by Codex $CODEX_THREAD_ID"
    return 0
  fi
  # ターミナルの前面にいるエージェント本人のときだけ貼る。エージェントが Bash ツールで起こした
  # claude -p や codex exec も同じ HC_TERMINAL_ID を受け継ぐので、親のラベルを上書きさせない
  if ! ap=$(agent_pid "$agent"); then
    log "record $agent $sid: no $agent above the hook"
    return 0
  fi
  SECONDS=0
  while :; do
    if ! term=$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null); then
      log "record $agent $sid: hc get failed"
      return 0
    fi
    read_fields '[.foreground.pid, .pid]' "$term"
    fg=${FIELDS[0]:-} pid=${FIELDS[1]:-}
    [ "$fg" = "$ap" ] && break
    # hc は前面のプロセスを 0.5 秒ほどおきに見直すので、起動した直後（Claude の SessionStart）は、まだ
    # シェルや、その前に終わったコマンドのままのことがある。ps で見て前面のジョブなら、追いつくまで待つ。
    # 締め切りは経過秒数で決める（2〜3 秒。hc get が遅くても、フックの timeout の 5 秒に収める）
    if ! foreground_job "$ap" "$pid"; then
      log "record $agent $sid: pid $ap is not in front (hc shows $fg)"
      return 0
    fi
    if [ "$SECONDS" -ge 3 ]; then
      log "record $agent $sid: hc still shows $fg in front, not $ap"
      return 0
    fi
    i=$((i + 1))
    sleep 0.1
  done
  read_fields '(.foreground.argv // [])' "$term"
  if one_shot "$agent" "${FIELDS[@]:1}"; then
    log "record $agent $sid: one-shot run"
    return 0
  fi
  if hc label "$HC_TERMINAL_ID" \
    "resume.agent=$agent" "resume.id=$sid" "resume.cwd=$cwd" \
    "resume.args=$(keep_args "$agent" "${FIELDS[@]:1}")" "resume.transcript=$transcript" \
    "resume.pid=$pid" "resume.boot=$(boot_id)" >/dev/null 2>&1; then
    log "record $agent $sid: labeled (asked hc $((i + 1)) times)"
  else
    log "record $agent $sid: hc label failed"
  fi
  return 0
}

cmd_end() {
  local agent=$1 input sid reason term rid
  input=$(cat)
  case "$agent" in claude | codex) ;; *) return 0 ;; esac
  [ -n "${HC_TERMINAL_ID:-}" ] && have_tools || return 0
  read_fields '[.session_id, .reason]' "$input"
  sid=${FIELDS[0]:-} reason=${FIELDS[1]:-}
  [[ $sid =~ $UUID_RE ]] || return 0
  # Claude は終わり方を reason で教えてくれる: /exit・Ctrl-C 2 回は prompt_input_exit、
  # シグナル（シャットダウン）は other、/clear は clear（このあと新しいセッションが始まる）。
  # Codex はシグナルを受けると終了処理をせずに落ちるので、SessionEnd が来るのは
  # 自分で終了したときだけ（reason はいつも other）
  if [ "$agent" = claude ]; then
    case "$reason" in
      prompt_input_exit | logout) ;;
      *)
        log "end claude $sid: kept ($reason)"
        return 0
        ;;
    esac
  fi
  if ! term=$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null); then
    log "end $agent $sid: hc get failed"
    return 0
  fi
  read_fields '[.labels["resume.id"]]' "$term"
  rid=${FIELDS[0]:-}
  # このセッションのラベルのときだけ消す
  if [ "$rid" != "$sid" ]; then
    log "end $agent $sid: labels are for ${rid:-no session}, kept"
    return 0
  fi
  clear_labels "end $agent $sid"
  return 0
}

# 戻ってきたシェルが打つコマンドを出す（フォルダ、コマンドの単語の順に、NUL で区切って終える）。
# 打つものがなければ何も出さない。hc に届かなかったときは 1 で終わる（次のプロンプトでもう一度試す）
# $1: そのシェルの pid
cmd_resume_line() {
  local shell_pid=$1 term i tpid agent sid cwd args transcript rpid rboot parent a
  local -a words=() rest=()
  [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "$shell_pid" ] && have_tools || return 0
  # 再起動のあとは core が立ち上がったばかりのことがあるので、少し待って試し直す
  for i in 1 2 3; do
    term=$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null) && break
    [ "$i" -lt 3 ] || return 1
    sleep 0.3
  done
  read_fields '[.pid] + (.labels // {} | [.["resume.agent"], .["resume.id"], .["resume.cwd"],
    .["resume.args"], .["resume.transcript"], .["resume.pid"], .["resume.boot"]])' "$term"
  tpid=${FIELDS[0]:-} agent=${FIELDS[1]:-} sid=${FIELDS[2]:-} cwd=${FIELDS[3]:-} args=${FIELDS[4]:-}
  transcript=${FIELDS[5]:-} rpid=${FIELDS[6]:-} rboot=${FIELDS[7]:-}
  [ -n "$agent" ] || return 0
  # ターミナルの最上位のシェルだけが扱う（その中で起動した zsh や tmux は触らない）
  if [ "$tpid" != "$shell_pid" ]; then
    parent=$(ps -o ppid= -p "$shell_pid" 2>/dev/null | tr -d ' ')
    parent=$(ps -o comm= -p "${parent:-0}" 2>/dev/null)
    [ "${parent##*/}" = herdr-core ] || return 0
  fi
  # ラベルを持つシェルのまま（herdr-app のメニューから起動したエージェントが終わり、ラッパーが exec
  # したシェルなど）: 戻ってきたのではないので打たない。ラベルも消さない。シャットダウンの SIGTERM では
  # エージェントだけが落ち、対話シェルは SIGTERM を無視して残るので、ここで消すと再起動のあとに戻せない
  if [ "$rpid" = "$shell_pid" ] && [ "$rboot" = "$(boot_id)" ]; then
    log "resume-line $agent $sid: same shell $shell_pid, kept for after a restart"
    return 0
  fi
  case "$agent" in
    claude | codex) ;;
    *)
      clear_labels "resume-line: unknown agent $agent"
      return 0
      ;;
  esac
  # セッション ID のない Codex（以前の版がまだ何も送っていない Codex に貼っていた）もここで消える
  if ! [[ $sid =~ $UUID_RE ]]; then
    clear_labels "resume-line $agent: no session id"
    return 0
  fi
  if ! jq -e 'type == "array" and all(.[]; type == "string")' <<<"$args" >/dev/null 2>&1; then
    clear_labels "resume-line $agent $sid: bad resume.args"
    return 0
  fi
  # メッセージを一度も送っていないセッションは記録がなく再開できないので、シェルのままにする
  if [ -n "$transcript" ] && [ ! -e "$transcript" ]; then
    clear_labels "resume-line $agent $sid: nothing was sent"
    return 0
  fi
  read_fields '.' "$args"
  words=(${FIELDS[@]+"${FIELDS[@]}"})
  # ラベルは消さずに、このシェルが引き継いだことにする。同じシェルではもう打たず、再開した
  # エージェントを自分で終了すれば消え、そのまま次の再起動を迎えたら、次のシェルがもう一度再開する
  hc label "$HC_TERMINAL_ID" "resume.pid=$shell_pid" "resume.boot=$(boot_id)" >/dev/null 2>&1
  case "$agent" in
    claude) words=(claude ${words[@]+"${words[@]}"} --resume "$sid") ;;
    codex)
      # hc のターミナルでは Codex を --no-daemon で動かす（共有のデーモンだと、セッションもフックもコマンドも hc の外で動く）
      for a in ${words[@]+"${words[@]}"}; do
        [ "$a" = --no-daemon ] || rest+=("$a")
      done
      words=(codex resume --no-daemon ${rest[@]+"${rest[@]}"} "$sid")
      ;;
  esac
  log "resume-line $agent $sid: typed ${words[*]} in $cwd"
  printf '%s\0' "$cwd" "${words[@]}"
}

cmd_init_zsh() {
  cat <<'EOF'
# agent-resume init zsh
# 戻ってきたタブの最初のプロンプトでエージェントを再開する
typeset -g _agent_resume_tries=0 _agent_resume_line=
_agent_resume_precmd() {
  emulate -L zsh
  (( _agent_resume_tries < 3 )) || return 0
  (( _agent_resume_tries++ ))
  local out
  out=$(command agent-resume resume-line $$) || return 0
  _agent_resume_tries=3
  [[ -n $out ]] || return 0
  # フォルダ、コマンドの単語の順に、NUL で区切って届く
  local -a w=("${(@0)${out%$'\0'}}")
  (( $#w > 1 )) || return 0
  _agent_resume_line=${(j: :)${(@q-)w[2,-1]}}
  [[ -n $w[1] ]] && _agent_resume_line="cd -- ${(q-)w[1]} && $_agent_resume_line"
  autoload -Uz add-zle-hook-widget
  add-zle-hook-widget line-init _agent_resume_line_init
}
# 打ったのと同じ扱いで実行する（履歴に残り、Ctrl-Z も効く）
_agent_resume_line_init() {
  emulate -L zsh
  add-zle-hook-widget -d line-init _agent_resume_line_init
  [[ -n $_agent_resume_line ]] || return 0
  BUFFER=$_agent_resume_line
  _agent_resume_line=
  zle accept-line
  return 0
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _agent_resume_precmd
# プロンプトで打った codex も、herdr-app のメニューと同じく --no-daemon で動かす。共有のデーモンに
# つなぐと、セッションもフックもデーモンの中で動き、どのタブのものか分からないので記録できない。
# --no-daemon は 2 回付けるとエラーになり、--remote とは一緒に使えない。デーモンを使うときは command codex。
function codex {
  emulate -L zsh
  local -a flags=(--no-daemon)
  (( ${argv[(I)(--no-daemon|--remote|--remote=*)]} )) && flags=()
  command codex $flags "$@"
}
EOF
}

case "${1:-}" in
  record) cmd_record "${2:-}" ;;
  end) cmd_end "${2:-}" ;;
  resume-line) cmd_resume_line "${2:-}" || exit 1 ;;
  # 以前の版の init zsh を読み込んだまま開いているシェルが呼ぶ。開き直すまで、何もせずに 0 で終わる
  pending | sweep) ;;
  init)
    if [ "${2:-}" != zsh ]; then
      echo "agent-resume: init supports zsh only" >&2
      exit 2
    fi
    cmd_init_zsh
    ;;
  *)
    echo "usage: agent-resume record|end <claude|codex> | init zsh" >&2
    exit 2
    ;;
esac
exit 0
